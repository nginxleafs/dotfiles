// ! DO NOT EDIT !
// ! AUTO-GENERATED BY DMS !
// ! CHANGES WILL BE OVERWRITTEN !
// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !

input {
    mouse {
        accel-speed 0.0
    }
    touchpad {
        tap
        accel-speed -0.3
        accel-profile "flat"
        natural-scroll
        dwt
        scroll-factor 0.3
    }
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:caps_toggle"
        }
        repeat-delay 250
        repeat-rate 45
    }
}

